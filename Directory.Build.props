<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Version>0.2.1</Version>
    <Authors>Henry Phan</Authors>
    <Company>Phan Software</Company>
    <Product>PHax</Product>
    <Copyright>Copyright © 2026 Henry Phan (Phan Software). Apache-2.0 with Commons Clause.</Copyright>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
