<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PHax.App.Views.ScanDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Scan document"
    PrimaryButtonText="Scan"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="Scan_Click"
    Closing="Dialog_Closing">
    <StackPanel Spacing="12" MinWidth="420">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ScannerBox" Header="Scanner" HorizontalAlignment="Stretch" PlaceholderText="Looking for scanners…" />
            <Button x:Name="RefreshButton" Grid.Column="1" VerticalAlignment="Bottom" Click="Refresh_Click" ToolTipService.ToolTip="Search for scanners again">
                <SymbolIcon Symbol="Refresh" />
            </Button>
        </Grid>
        <ComboBox x:Name="SourceBox" Header="Paper source" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Automatic" Tag="Auto" />
            <ComboBoxItem Content="Flatbed (glass)" Tag="Flatbed" />
            <ComboBoxItem Content="Document feeder" Tag="Feeder" />
            <ComboBoxItem Content="Document feeder, both sides" Tag="Duplex" />
        </ComboBox>
        <ComboBox x:Name="PageSizeBox" Header="Page size" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Letter" Tag="Letter" />
            <ComboBoxItem Content="Legal" Tag="Legal" />
            <ComboBoxItem Content="A4" Tag="A4" />
        </ComboBox>
        <ComboBox x:Name="ModeBox" Header="Content" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Automatic" Tag="Auto" />
            <ComboBoxItem Content="Text (sharpest)" Tag="Threshold" />
            <ComboBoxItem Content="Photos and shading" Tag="Dither" />
        </ComboBox>
        <CheckBox x:Name="NativeUiBox" Content="Use the scanner's own settings window" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ProgressRing x:Name="Ring" IsActive="False" Width="20" Height="20" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="400" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
