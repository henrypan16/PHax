<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PHax.App.Views.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fax preview">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right">
            <AppBarButton Icon="Print" Label="Print" Click="Print_Click" />
            <AppBarButton Icon="Save" Label="Save as PDF" Click="SavePdf_Click" />
            <AppBarSeparator />
            <AppBarElementContainer VerticalAlignment="Center">
                <TextBlock x:Name="PageInfo" Margin="12,0" VerticalAlignment="Center" />
            </AppBarElementContainer>
        </CommandBar>
        <ScrollViewer Grid.Row="1" ZoomMode="Enabled" MinZoomFactor="0.2" MaxZoomFactor="4" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="PagesPanel" Spacing="16" Padding="24" HorizontalAlignment="Center" />
        </ScrollViewer>
    </Grid>
</Window>
