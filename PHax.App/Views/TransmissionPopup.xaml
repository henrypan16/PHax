<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PHax.App.Views.TransmissionPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PHax transmission">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid Padding="16,12,8,12" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="StateIcon" Glyph="&#xE724;" FontSize="26" VerticalAlignment="Center"
                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="DetailText" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressBar x:Name="Bar" Maximum="100" Margin="0,6,0,0" IsIndeterminate="True" />
        </StackPanel>
        <Button Grid.Column="2" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="6"
                Click="Close_Click" ToolTipService.ToolTip="Hide">
            <FontIcon Glyph="&#xE711;" FontSize="11" />
        </Button>
    </Grid>
</Window>
