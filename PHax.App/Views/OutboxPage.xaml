<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PHax.App.Views.OutboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PHax.App.Views"
    xmlns:vm="using:PHax.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Outbox" Style="{StaticResource PageTitle}" />
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" IsEnabled="{x:Bind local:Bind.IsNotNull(ViewModel.Selected), Mode=OneWay}">
                <AppBarButton Icon="Cancel" Label="Cancel" Click="Cancel_Click" />
                <AppBarButton Icon="Pause" Label="Pause" Click="Pause_Click" />
                <AppBarButton Icon="Play" Label="Resume" Click="Resume_Click" />
                <AppBarButton Icon="Refresh" Label="Retry" Click="Retry_Click" />
                <AppBarButton Icon="Preview" Label="Preview" Click="Preview_Click" />
                <AppBarButton Icon="Delete" Label="Delete" Click="Delete_Click" />
            </CommandBar>
            <AutoSuggestBox Grid.Column="1" PlaceholderText="Search" QueryIcon="Find" VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.Search, Mode=TwoWay}" />
        </Grid>
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:OutboundItem">
                    <Grid Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Number, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind LiveMessage, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Visibility="{x:Bind local:Bind.VisibleIfText(LiveMessage), Mode=OneWay}" />
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Width="320" HorizontalAlignment="Left"
                                         Visibility="{x:Bind local:Bind.Visible(IsActive), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ErrorText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Visibility="{x:Bind local:Bind.Visible(HasError), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right" MinWidth="200">
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind AttemptsText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind NextRetryText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind PagesText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="2" Text="The outbox is empty." Visibility="{x:Bind local:Bind.Visible(ViewModel.IsEmpty), Mode=OneWay}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
