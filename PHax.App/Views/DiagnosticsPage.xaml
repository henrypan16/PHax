<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PHax.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PHax.App.ViewModels">
    <Page.Resources>
        <DataTemplate x:Key="LineTemplate" x:DataType="vm:DiagnosticLine">
            <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" IsTextSelectionEnabled="True">
                <Run Text="{x:Bind Time}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Run Text="{x:Bind Category}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Run Text="{x:Bind Message}" />
            </TextBlock>
        </DataTemplate>
    </Page.Resources>
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CommandBar Grid.Row="1" HorizontalAlignment="Left" DefaultLabelPosition="Right">
            <AppBarButton Icon="Refresh" Label="Refresh" Click="Refresh_Click" />
            <AppBarButton Icon="Save" Label="Export logs" Click="Export_Click" />
            <AppBarButton Icon="Folder" Label="Open log folder" Click="OpenLogs_Click" />
            <AppBarToggleButton x:Name="Follow" Icon="Play" Label="Live" IsChecked="True" />
        </CommandBar>
        <Grid Grid.Row="2" Padding="16" CornerRadius="8" ColumnSpacing="32" RowSpacing="4"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Modem state" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="StateText" Grid.Column="1" />
            <TextBlock Grid.Column="2" Text="Port / modem" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="PortText" Grid.Column="3" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="Fax class" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ClassText" Grid.Row="1" Grid.Column="1" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="T.30 phase" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="PhaseText" Grid.Row="1" Grid.Column="3" />
            <TextBlock Grid.Row="2" Text="Modulation" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ModText" Grid.Row="2" Grid.Column="1" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Resolution" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ResText" Grid.Row="2" Grid.Column="3" />
            <TextBlock Grid.Row="3" Text="Last error" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ErrorText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" TextWrapping="Wrap" />
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="AT command history" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Grid.Column="1" Text="Protocol events (T.30, modem, jobs)" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ListView x:Name="AtList" Grid.Row="1" ItemsSource="{x:Bind AtLines}" ItemTemplate="{StaticResource LineTemplate}" SelectionMode="None"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
            <ListView x:Name="EventList" Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind EventLines}" ItemTemplate="{StaticResource LineTemplate}" SelectionMode="None"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Grid>
    </Grid>
</Page>
