<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PHax.App.Views.FaxPreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PaneButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </UserControl.Resources>
    <Grid CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="12,4,4,4" ColumnSpacing="8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <!-- ContentControl: StackPanel has no IsEnabled to disable the buttons as a group. -->
            <ContentControl x:Name="Tools" Grid.Column="1" IsEnabled="False" IsTabStop="False">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PaneButton}" Click="PreviousPage_Click" ToolTipService.ToolTip="Previous page">
                        <FontIcon Glyph="&#xE70E;" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="PageInfo" VerticalAlignment="Center" Margin="4,0" MinWidth="80" TextAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button Style="{StaticResource PaneButton}" Click="NextPage_Click" ToolTipService.ToolTip="Next page">
                        <FontIcon Glyph="&#xE70D;" FontSize="14" />
                    </Button>
                    <AppBarSeparator />
                    <Button Style="{StaticResource PaneButton}" Click="ZoomOut_Click" ToolTipService.ToolTip="Zoom out (Ctrl+-)">
                        <SymbolIcon Symbol="ZoomOut" />
                    </Button>
                    <Button Style="{StaticResource PaneButton}" Click="ZoomIn_Click" ToolTipService.ToolTip="Zoom in (Ctrl++)">
                        <SymbolIcon Symbol="ZoomIn" />
                    </Button>
                    <Button Style="{StaticResource PaneButton}" Click="FitWidth_Click" ToolTipService.ToolTip="Fit page width (Ctrl+0)">
                        <FontIcon Glyph="&#xE9A6;" />
                    </Button>
                    <Button x:Name="OpenButton" Style="{StaticResource PaneButton}" Click="Open_Click" ToolTipService.ToolTip="Open in a separate window">
                        <FontIcon Glyph="&#xE8A7;" />
                    </Button>
                </StackPanel>
            </ContentControl>
        </Grid>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="4"
                      HorizontalScrollBarVisibility="Auto" ViewChanged="Scroller_ViewChanged" SizeChanged="Scroller_SizeChanged">
            <StackPanel x:Name="PagesPanel" Spacing="16" Padding="16" HorizontalAlignment="Center" />
        </ScrollViewer>
        <TextBlock x:Name="HintText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ProgressRing x:Name="Ring" Grid.Row="1" IsActive="False" />
    </Grid>
</UserControl>
