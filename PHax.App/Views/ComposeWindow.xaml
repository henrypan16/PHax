<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PHax.App.Views.ComposeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PHax.App.Views"
    xmlns:vm="using:PHax.App.ViewModels"
    Title="New Fax">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Padding="24" ColumnSpacing="24" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Spacing="12">
                <TextBlock Text="New fax" Style="{StaticResource TitleTextBlockStyle}" />
                <AutoSuggestBox x:Name="RecipientBox" Header="Recipient name" Text="{x:Bind ViewModel.RecipientName, Mode=TwoWay}"
                                TextChanged="Recipient_TextChanged" SuggestionChosen="Recipient_SuggestionChosen" DisplayMemberPath="Name" />
                <TextBox Header="Fax number" InputScope="TelephoneNumber" Text="{x:Bind ViewModel.FaxNumber, Mode=TwoWay}" />
                <TextBox Header="Subject" Text="{x:Bind ViewModel.Subject, Mode=TwoWay}" />
                <ToggleSwitch Header="Cover page" IsOn="{x:Bind ViewModel.IncludeCoverPage, Mode=TwoWay}" />
                <TextBox Header="Cover page message" AcceptsReturn="True" TextWrapping="Wrap" Height="140"
                         Text="{x:Bind ViewModel.CoverMessage, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IncludeCoverPage, Mode=OneWay}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Attachments" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Click="Add_Click" ToolTipService.ToolTip="Add files"><SymbolIcon Symbol="Attach" /></Button>
                        <Button Click="Up_Click" ToolTipService.ToolTip="Move up"><SymbolIcon Symbol="Up" /></Button>
                        <Button Click="Down_Click" ToolTipService.ToolTip="Move down"><SymbolIcon Symbol="Download" /></Button>
                        <Button Click="Remove_Click" ToolTipService.ToolTip="Remove"><SymbolIcon Symbol="Delete" /></Button>
                    </StackPanel>
                </Grid>
                <ListView ItemsSource="{x:Bind ViewModel.Attachments}" SelectedItem="{x:Bind ViewModel.SelectedAttachment, Mode=TwoWay}"
                          MinHeight="120" MaxHeight="260" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          AllowDrop="True" DragOver="List_DragOver" Drop="List_Drop" CanReorderItems="True" SelectionChanged="Attachments_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttachmentItem">
                            <Grid Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind PagesText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="PDF, TIFF, PNG, JPEG and BMP. Drag files here or use the attach button. Pages are sent in list order."
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer ZoomMode="Enabled" HorizontalScrollBarVisibility="Auto">
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="12" />
                </ScrollViewer>
                <TextBlock x:Name="PreviewHint" Text="Select an attachment to preview its first page as it will be faxed."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressRing x:Name="PreviewRing" IsActive="False" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Content="Save as Draft" Click="SaveDraft_Click" IsEnabled="{x:Bind local:Bind.Not(ViewModel.IsBusy), Mode=OneWay}" />
            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="Send_Click" IsEnabled="{x:Bind local:Bind.Not(ViewModel.IsBusy), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Send" />
                    <TextBlock Text="Send Fax" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
