<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>PHax.Service</RootNamespace>
    <AssemblyName>PHax.Service</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('..\PHax.App\Assets\PHax.ico')">
    <ApplicationIcon>..\PHax.App\Assets\PHax.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PHax.Core\PHax.Core.csproj" />
    <ProjectReference Include="..\PHax.Data\PHax.Data.csproj" />
    <ProjectReference Include="..\PHax.Modem\PHax.Modem.csproj" />
    <ProjectReference Include="..\PHax.Imaging\PHax.Imaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PHax.Tests" />
  </ItemGroup>
</Project>
